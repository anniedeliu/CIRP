<?xml version='1.0' encoding='UTF-8'?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="en-US" page-range-format="expanded" initialize-with-hyphen="false" demote-non-dropping-particle="never">
  <info>
    <title>CIRP Custom - Numeric Comma Format v2</title>
    <id>https://raw.githubusercontent.com/anniedeliu/CIRP/main/CIRP_Custom_Comma_Format.csl</id>
    <link href="https://raw.githubusercontent.com/anniedeliu/CIRP/main/CIRP_Custom_Comma_Format.csl" rel="self"/>
    <author><name>Custom style prepared for Wenyi Liu</name></author>
    <category citation-format="numeric"/>
    <category field="engineering"/>
    <summary>Custom user-requested comma-separated references. Surname and punctuated initials, year, full title, full journal name, volume(issue): full pages. Website references include last-access dates. Not an official CIRP style; punctuation follows the supplied Budak example.</summary>
    <updated>2026-11-01T00:00:00+00:00</updated>
    <rights license="https://creativecommons.org/licenses/by/4.0/">Creative Commons Attribution 4.0 International</rights>
  </info>
  <locale xml:lang="en">
    <terms><term name="page-range-delimiter">–</term><term name="citation-range-delimiter">–</term></terms>
  </locale>
  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=", " initialize-with=". " delimiter=", "/>
      <substitute><names variable="editor"/><text variable="title"/></substitute>
    </names>
  </macro>
  <macro name="year">
    <choose>
      <if variable="issued"><date variable="issued"><date-part name="year"/></date></if>
      <else><text value="n.d."/></else>
    </choose>
  </macro>
  <macro name="journal-details">
    <group delimiter=", ">
      <text variable="container-title"/>
      <group delimiter=": ">
        <group><text variable="volume"/><text variable="issue" prefix="(" suffix=")"/></group>
        <text variable="page"/>
      </group>
    </group>
  </macro>
  <macro name="web-access">
    <group delimiter=" ">
      <text variable="URL"/>
      <date variable="accessed" delimiter=" " prefix="(accessed " suffix=")">
        <date-part name="day"/><date-part name="month" form="short" strip-periods="true"/><date-part name="year"/>
      </date>
    </group>
  </macro>
  <macro name="publisher">
    <group delimiter=", "><text variable="publisher"/><text variable="publisher-place"/></group>
  </macro>
  <citation>
    <sort><key variable="citation-number"/></sort>
    <layout prefix="[" suffix="]" delimiter=", "><text variable="citation-number"/></layout>
  </citation>
  <bibliography entry-spacing="0" line-spacing="1" second-field-align="flush">
    <sort><key variable="citation-number"/></sort>
    <layout>
      <text variable="citation-number" prefix="[" suffix="] "/>
      <group delimiter=", ">
        <text macro="author"/>
        <text macro="year"/>
        <group delimiter=", " suffix=".">
          <text variable="title"/>
          <choose>
            <if type="article-journal article-magazine article-newspaper" match="any"><text macro="journal-details"/></if>
            <else-if type="webpage post post-weblog" match="any"><text macro="web-access"/></else-if>
            <else-if type="chapter paper-conference" match="any">
              <group delimiter=", ">
                <text variable="container-title" prefix="In: "/>
                <text macro="publisher"/>
                <text variable="page"/>
              </group>
            </else-if>
            <else>
              <group delimiter=". "><text macro="publisher"/><choose><if variable="URL"><text macro="web-access"/></if></choose></group>
            </else>
          </choose>
        </group>
      </group>
    </layout>
  </bibliography>
</style>
